# .env.example — Variáveis de ambiente do backend Predicta
# Copie para ".env" e ajuste quando for plugar o PostgreSQL.
# (O .env é ignorado pelo git — não comite credenciais.)

# ── Fonte de dados ────────────────────────────────────────────────
# false = usa o SEED em memória (padrão); true = lê do PostgreSQL.
PREDICTA_USAR_POSTGRES=false

# ── Conexão PostgreSQL (usada só quando PREDICTA_USAR_POSTGRES=true) ─
PREDICTA_DB_HOST=localhost
PREDICTA_DB_PORT=5432
PREDICTA_DB_NAME=simpa_db
PREDICTA_DB_USER=postgres
PREDICTA_DB_PASSWORD=123456
# Tabela/view com os registros acadêmicos (1 linha por aluno×disciplina).
PREDICTA_DB_VIEW=estatisticasalunos

# ── Segurança ─────────────────────────────────────────────────────
# Em produção, gere uma chave longa e aleatória.
PREDICTA_SECRET=troque-esta-chave-em-producao
PREDICTA_TOKEN_MIN=480
PREDICTA_SENHA_DEMO=predicta123

# ── Diversos ──────────────────────────────────────────────────────
PREDICTA_CORS=*
PREDICTA_LOG_LEVEL=INFO
